# Kosh configuration. Copy to .env (gitignored) and fill in.
# Nothing here is a password for a target site — see CLAUDE.md rule 5:
# Webcmd profiles are cookie jars, we store sessions, never credentials.

# --- Stores -----------------------------------------------------------------
# SQLite (default, zero-setup, used by tests and by `kosh verify-foundation`):
KOSH_DATABASE_URL=sqlite:///data/kosh.sqlite
# Postgres (production):
# KOSH_DATABASE_URL=postgresql://kosh:kosh@localhost:5433/kosh

# Content-addressed raw blob store. Append-only directory; never prune it.
KOSH_BLOB_ROOT=data/blobs

# --- Collection -------------------------------------------------------------
# Default politeness floor between requests to the same host, seconds.
KOSH_MIN_REQUEST_INTERVAL=1.5
KOSH_USER_AGENT=kosh/0.1 (+market-data-research; contact: you@example.com)
KOSH_HTTP_TIMEOUT=30

# How far back `kosh catchup` will try to fill a detected gap.
KOSH_MAX_CATCHUP_DAYS=30

# --- Webcmd -----------------------------------------------------------------
# Profile directory for cookie jars. Ring 3 profiles must stay on this machine.
KOSH_WEBCMD_PROFILE_DIR=data/webcmd-profiles

# --- Monitoring -------------------------------------------------------------
# Volume drift: alert when a run's row count deviates from the trailing median
# by more than this fraction. Zero rows on an expected day is always P0.
KOSH_DRIFT_THRESHOLD=0.4
KOSH_DRIFT_WINDOW=14

# --- Ring 3 (local only, never hosted) --------------------------------------
KOSH_RING3_ENABLED=false
